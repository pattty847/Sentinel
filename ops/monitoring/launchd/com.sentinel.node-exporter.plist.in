<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- node_exporter with the darwin collectors the dashboards use. Rendered by install.sh. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.sentinel.node-exporter</string>
  <key>ProgramArguments</key><array>
    <string>@BREW@/opt/node_exporter/bin/node_exporter</string>
    <string>--web.listen-address=127.0.0.1:9100</string>
    <string>--collector.disable-defaults</string>
    <string>--collector.cpu</string>
    <string>--collector.meminfo</string>
    <string>--collector.filesystem</string>
    <string>--collector.diskstats</string>
    <string>--collector.loadavg</string>
    <string>--collector.boottime</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOGS@/monitoring-node-exporter.out</string>
  <key>StandardErrorPath</key><string>@LOGS@/monitoring-node-exporter.err</string>
</dict></plist>

{
  "uid": "sentinel-recorder",
  "title": "Sentinel recorder detail",
  "tags": [
    "sentinel"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Health",
      "type": "link",
      "url": "/d/sentinel-health",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "Columns written per minute",
      "description": "Expected in roller mode: rolled products x 2 layers per minute. Counts committed minute appends; excludes hourly rollups and replay below the checkpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "rate(sentinel_recorder_columns_written_total[5m]) * 60",
          "legendFormat": "columns/min",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Journal invalidations (per 5 min)",
      "description": "Per-product journal book invalidations. No roller equivalent for primary late-event or backward-step counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_roller_invalidations_total[5m])",
          "legendFormat": "invalidations {{product}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Write errors and live drops (per 5 min)",
      "description": "Per-product HMC2 append failures and refused live publications. The roller uses blocking recorder admission; no primary queue-drop equivalent.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_roller_write_errors_total[5m])",
          "legendFormat": "write errors {{product}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_recorder_live_publish_drops_total[5m])",
          "legendFormat": "live publish drops",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream transport",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_mdc_connected{pinned=\"1\"}",
          "legendFormat": "{{product}} connected",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_mdc_transport_down_total{pinned=\"1\"}[1h])",
          "legendFormat": "{{product}} downs in last hour",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Coinbase WebSocket latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",

{
  "uid": "sentinel-recorder",
  "title": "Sentinel recorder detail",
  "tags": [
    "sentinel"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Health",
      "type": "link",
      "url": "/d/sentinel-health",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "Columns written per minute",
      "description": "Expected in roller mode: rolled products x 2 layers per minute. Counts committed minute appends; excludes hourly rollups and replay below the checkpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "rate(sentinel_recorder_columns_written_total[5m]) * 60",
          "legendFormat": "columns/min",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Journal invalidations (per 5 min)",
      "description": "Per-product journal book invalidations.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_roller_invalidations_total[5m])",
          "legendFormat": "invalidations {{product}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Write errors and live drops (per 5 min)",
      "description": "Per-product HMC2 append failures and refused live publications. The roller uses lossless blocking recorder admission.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_roller_write_errors_total[5m])",
          "legendFormat": "write errors {{product}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_recorder_live_publish_drops_total[5m])",
          "legendFormat": "live publish drops",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Live journal feed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_live_feed_up",
          "legendFormat": "{{product}} connected",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_live_feed_down_total[1h])",
          "legendFormat": "{{product}} downs in last hour",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Live feed lag (roller)",
      "description": "Age of the last journal record the roller applied, per product. Replaces the Coinbase WebSocket latency panel: since the 2026-10-11 cutover the server has no Coinbase socket; capture is the only connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_roller_shadow_lag_seconds >= 0",
          "legendFormat": "{{product}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Exchange clock offset",
      "description": "Smoothed local minus exchange time. Over 2 s skews every age metric.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_exchange_clock_offset_ms",
          "legendFormat": "local - exchange",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Stream sessions",
      "description": "Open GUI/client stream sessions.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_stream_sessions",
          "legendFormat": "sessions",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "sentinel-server memory",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "process_resident_memory_bytes{job=\"sentinel-server\"}",
          "legendFormat": "RSS",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "sentinel-server CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"sentinel-server\"}[5m])",
          "legendFormat": "cores",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Restarts",
      "description": "Process restarts (deploys, crashes, exit 75).",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "changes(process_start_time_seconds{job=\"sentinel-server\"}[1h])",
          "legendFormat": "restarts in last hour",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Filesystem free",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=~\"/Volumes/T7|/System/Volumes/Data\"}",
          "legendFormat": "{{mountpoint}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Host CPU and memory",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "CPU busy",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "(node_memory_active_bytes + node_memory_wired_bytes + node_memory_compressed_bytes) / node_memory_total_bytes",
          "legendFormat": "memory active+wired+compressed",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Ingest (capture)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Capture queue bytes per product",
      "description": "Bytes each product has queued for its disk worker. Scrape interval is 15 s, so a spike shorter than one scrape is invisible here.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_capture_queue_bytes{job=\"sentinel-capture\"}",
          "legendFormat": "{{product}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Capture queue pool usage",
      "description": "Share of the shared capture queue pool in use. The capture exits when the pool is full (alert A4b fires above 50%). Scrape interval is 15 s, so a spike shorter than one scrape is invisible here.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "100 * sum(sentinel_capture_queue_used_bytes{job=\"sentinel-capture\"}) / max(sentinel_capture_queue_pool_bytes{job=\"sentinel-capture\"})",
          "legendFormat": "pool used",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Capture reconnects per hour",
      "description": "Reconnects per product in the last hour. The gauge is the established connection id, so each reconnect adds 1. Normal is 0-3 per hour. A capture restart or deploy resets the id and shows as one extra reconnect per product at that hour; compare with changes(process_start_time_seconds{job=\"sentinel-capture\"}[1h]).",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_capture_connection{job=\"sentinel-capture\"}[1h])",
          "legendFormat": "{{product}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Fan-out ingress drops and overflow (per 5 min)",
      "description": "Record or control events that fan-out ingress refused (forces a socket resume; journal records are not dropped), and client disconnects with reason ingress_overflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_fanout_ingress_drops_total{job=\"sentinel-capture\"}[5m])",
          "legendFormat": "drops {{product}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_fanout_disconnects_total{job=\"sentinel-capture\",reason=\"ingress_overflow\"}[5m])",
          "legendFormat": "ingress_overflow disconnects",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Fan-out client queue bytes",
      "description": "Largest pending wire byte count over the 8 fan-out client slots. Scrape interval is 15 s, so a spike shorter than one scrape is invisible here.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "max(sentinel_fanout_queue_bytes{job=\"sentinel-capture\"})",
          "legendFormat": "max client queue",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}

            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_mdc_ws_latency_ms",
          "legendFormat": "latency",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {

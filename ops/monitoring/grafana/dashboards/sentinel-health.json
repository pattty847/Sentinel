{
  "uid": "sentinel-health",
  "title": "Sentinel health",
  "tags": [
    "sentinel"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Recorder detail",
      "type": "link",
      "url": "/d/sentinel-recorder",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Upstream connected",
      "description": "sentinel-server market-data transport. Alert A1b after 5 min down.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "min by (product) (sentinel_mdc_connected{pinned=\"1\"})",
          "legendFormat": "{{product}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets up",
      "description": "Scrape succeeded (1) per job. Alert A3 after 2 min down. Capture joins in slice 2.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "up{job=~\"sentinel-.*|node\"}",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "T7 free",
      "description": "No value = T7 not mounted (alert A3b after 5 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/Volumes/T7\"}",
          "legendFormat": "T7",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50000000000.0
              },
              {
                "color": "green",
                "value": 100000000000.0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Roller errors (1h)",
      "description": "Per-product HMC2 append failures should be 0; journal invalidations can occur on reconnect. The roller uses blocking recorder admission, so the primary queue-drop target is removed.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_roller_write_errors_total[1h])",
          "legendFormat": "write errors {{product}}",
          "range": false,
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_roller_invalidations_total[1h])",
          "legendFormat": "invalidations {{product}}",
          "range": false,
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "increase(sentinel_recorder_live_publish_drops_total[1h])",
          "legendFormat": "live drops",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Recorder last column age",
      "description": "Seconds since the start of the newest committed minute column. Normal: 60-125 s (minute + lateness). Gaps: no column yet since start.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "time() - sentinel_recorder_last_column_timestamp_seconds",
          "legendFormat": "{{product}} {{layer}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 182
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Recorder column overdue",
      "description": "Seconds the next column is past due (stall monitor). 0 = on time; alert A1 above 60 s for 1 min. No value while the upstream is disconnected.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_recorder_column_overdue_seconds",
          "legendFormat": "{{product}} {{layer}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Capture feeds down",
      "description": "Seconds each sentinel-capture product's WebSocket has been down (0 = up). Alert A4 above 120 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_capture_feed_down_seconds{job=\"sentinel-capture\"}",
          "legendFormat": "{{product}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Capture queue",
      "description": "Share of the capture's shared disk queue pool in use (0 in steady state). Alert A4b above 50 % for 2 min (FM-127: the queue grows when T7 I/O stalls).",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-vm"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-vm"
          },
          "expr": "sentinel_capture_queue_used_bytes{job=\"sentinel-capture\"} / sentinel_capture_queue_pool_bytes{job=\"sentinel-capture\"}",
          "legendFormat": "pool used",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    }
  ]
}

#version 440
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer Packed { uint packed[]; };
layout(std430, binding = 1) readonly buffer Offsets { uint offset[]; };
layout(std430, binding = 2) readonly buffer Coverage { ivec4 coverage[]; };
layout(std430, binding = 3) readonly buffer Durations { uint observedMs[]; };
struct ColumnMeta { uint factor; float floor; float codesPerOctave; uint reserved; };
layout(std430, binding = 4) readonly buffer NativeFactors { ColumnMeta columnMeta[]; };
layout(std430, binding = 5) readonly buffer EntryCovered { uint entryCoveredMs[]; };
layout(std430, binding = 6) readonly buffer CoverageRuns { ivec4 run[]; };
layout(std430, binding = 7) readonly buffer RunOffsets { uint runOffset[]; };
layout(std430, binding = 8) writeonly buffer Output { vec4 cell[]; };
layout(std140, binding = 9) uniform Params {
    uvec4 dims;   // output columns, rows, source minutes, native rows per display row
    ivec4 coords; // first source column, source columns/timeframe, relative bottom row, absolute base row
    vec4 scale;
};
float decodedSize(uint value, uint column) {
    return value == 0u ? 0.0 : columnMeta[column].floor *
        exp2((float(value & 0x7fffu) - 1.0) / columnMeta[column].codesPerOctave);
}
uint rawRowSide(uint i) {
    if (scale.x > 0.5) {
        uint value = packed[i];
        return (value & 0xffffu) | ((value & 0x10000u) != 0u ? 0x80000000u : 0u);
    }
    return packed[(i >> 1u) * 3u + (i & 1u)];
}
uint rawCode(uint i) {
    if (scale.x > 0.5) return (packed[i] >> 17u) & 0x7fffu;
    return (packed[(i >> 1u) * 3u + 2u] >> ((i & 1u) * 16u)) & 0xffffu;
}
uint coveredAt(uint c, bool askSide, uint row) {
    if (scale.z < 2.0) {
        ivec4 cov = coverage[c];
        return (askSide ? (cov.z <= int(row) && cov.w >= int(row)) :
                          (cov.x <= int(row) && cov.y >= int(row))) ? observedMs[c] : 0u;
    }
    uint a = runOffset[c * 2u + uint(askSide)], b = runOffset[c * 2u + uint(askSide) + 1u];
    while (a < b) {
        uint m = a + (b - a) / 2u;
        if (run[m].y < int(row)) a = m + 1u;
        else b = m;
    }
    return a < runOffset[c * 2u + uint(askSide) + 1u] && run[a].x <= int(row) ?
        uint(run[a].z) : 0u;
}
bool coversRange(uint c, bool askSide, int lo, int hi) {
    if (scale.z < 2.0) {
        ivec4 cov = coverage[c];
        return askSide ? (cov.z <= lo && cov.w >= hi) : (cov.x <= lo && cov.y >= hi);
    }
    uint cursor = uint(lo);
    uint a = runOffset[c * 2u + uint(askSide)], b = runOffset[c * 2u + uint(askSide) + 1u];
    while (a < b) {
        uint m = a + (b - a) / 2u;
        if (run[m].y < lo) a = m + 1u;
        else b = m;
    }
    for (uint i = a; i < runOffset[c * 2u + uint(askSide) + 1u] && cursor <= uint(hi); ++i) {
        if (run[i].x > int(cursor) || uint(run[i].z) != observedMs[c]) return false;
        cursor = uint(run[i].y + 1);
    }
    return cursor > uint(hi);
}
vec2 rawRange(uint c, uint lo, uint hi, float weight) {
    uint a = offset[c], b = offset[c + 1u];
    while (a < b) {
        uint m = a + (b - a) / 2u;
        if ((rawRowSide(m) & 0x7fffffffu) < lo) a = m + 1u;
        else b = m;
    }
    vec2 sums = vec2(0.0);
    for (uint i = a; i < offset[c + 1u] && (rawRowSide(i) & 0x7fffffffu) <= hi; ++i) {
        float quantity = decodedSize(rawCode(i), c) *
            (scale.z < 2.0 ? weight : float(entryCoveredMs[i]));
        if ((rawRowSide(i) & 0x80000000u) == 0u) sums.x += quantity;
        else sums.y += quantity;
    }
    return sums;
}
// Match RecordingPage: each native row/side uses its own covered duration.
// Distinct native grids are then weighted by their observed duration.
vec2 partialCoverageSums(uint first, uint end, uint lo, uint hi, float totalMs) {
    vec2 result = vec2(0.0);
    for (uint c = first; c < end; ++c) {
        if (observedMs[c] == 0u) continue;
        float gridMs = 0.0;
        for (uint d = first; d < end; ++d)
            if (observedMs[d] != 0u && columnMeta[d].factor == columnMeta[c].factor)
                gridMs += float(observedMs[d]);
        uint a = offset[c], b = offset[c + 1u];
        while (a < b) {
            uint m = a + (b - a) / 2u;
            if ((rawRowSide(m) & 0x7fffffffu) < lo) a = m + 1u;
            else b = m;
        }
        for (uint i = a; i < offset[c + 1u] && (rawRowSide(i) & 0x7fffffffu) <= hi; ++i) {
            uint row = rawRowSide(i) & 0x7fffffffu;
            bool askSide = (rawRowSide(i) & 0x80000000u) != 0u;
            float coveredMs = 0.0;
            for (uint d = first; d < end; ++d) {
                if (observedMs[d] == 0u || columnMeta[d].factor != columnMeta[c].factor) continue;
                coveredMs += float(coveredAt(d, askSide, row));
            }
            if (coveredMs > 0.0) {
                float numeratorMs = scale.z < 2.0 ? float(observedMs[c]) : float(entryCoveredMs[i]);
                float value = decodedSize(rawCode(i), c) * numeratorMs / coveredMs * gridMs / totalMs;
                if (askSide) result.y += value;
                else result.x += value;
            }
        }
    }
    return result;
}
void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= dims.x || y >= dims.y) return;
    int start = coords.x + int(x) * coords.y;
    int stop = start + coords.y;
    uint first = uint(clamp(start, 0, int(dims.z)));
    uint end = uint(clamp(stop, 0, int(dims.z)));
    int lo = coords.z + int((dims.y - 1u - y) * dims.w);
    int hi = lo + int(dims.w) - 1;
    float bid = 0.0, ask = 0.0, totalMs = 0.0;
    bool valid = end > first && lo >= 0;
    for (uint c = first; c < end; ++c) {
        if (observedMs[c] == 0u) continue;
        valid = valid && lo >= 0 && coversRange(c, false, lo, hi) && coversRange(c, true, lo, hi);
        float weight = float(observedMs[c]);
        totalMs += weight;
        if (hi >= 0) {
            vec2 sums = rawRange(c, uint(max(lo, 0)), uint(hi), weight);
            bid += sums.x; ask += sums.y;
        }
    }
    bool compatible = true;
    for (uint c = first; c < end; ++c) {
        uint factor = columnMeta[c].factor;
        if (observedMs[c] != 0u && (factor == 0u || dims.w % factor != 0u ||
            (lo + coords.w) % int(factor) != 0)) compatible = false;
    }
    if (totalMs <= 0.0 || !compatible) {
        cell[y * dims.x + x] = vec4(0.0);
        return;
    }
    if (!valid && scale.w < 0.5 && (end - first > 1u || scale.z > 1.0) &&
        hi >= 0 && (bid > 0.0 || ask > 0.0)) {
        vec2 corrected = partialCoverageSums(first, end, uint(max(lo, 0)), uint(hi), totalMs);
        bid = corrected.x * totalMs;
        ask = corrected.y * totalMs;
    }
    cell[y * dims.x + x] = vec4(bid / totalMs, ask / totalMs, valid ? 1.0 : 0.0, 0.0);
}

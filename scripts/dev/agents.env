# Tracked defaults. Existing environment values win; CLI flags win over both.
: "${CODEX_BIN:=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex}"
: "${CODEX_MODEL:=gpt-6-sol}"
: "${CODEX_EFFORT:=high}"
: "${CODEX_APPROVAL:=never}"
: "${CODEX_LOG_DIR:=$HOME/Library/Logs/Sentinel/codex}"

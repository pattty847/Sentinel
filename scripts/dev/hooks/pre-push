#!/usr/bin/env bash
# Client-side policy, intentionally bypassable with git push --no-verify.
set -euo pipefail
# -c keeps stdin available for Git's ref-update protocol; -I ignores local Python.
exec python3 -I -c '
import subprocess, sys

def git(*args):
    return subprocess.check_output(["git", *args], stderr=subprocess.PIPE)

def ancestor(a, b):
    result = subprocess.run(["git", "merge-base", "--is-ancestor", a, b], capture_output=True)
    if result.returncode not in (0, 1):
        raise RuntimeError(result.stderr.decode(errors="replace"))
    return result.returncode == 0

def config(name, default=None):
    result = subprocess.run(["git", "config", "--get", name], capture_output=True, text=True)
    if result.returncode == 1:
        return default
    if result.returncode:
        raise RuntimeError(result.stderr)
    return result.stdout.strip()

def zero(sha):
    return bool(sha) and set(sha) == {"0"}

errors = []
try:
    for line in sys.stdin:
        local_ref, local, remote_ref, remote = line.split()
        if remote_ref != "refs/heads/main":
            continue
        if zero(local):
            errors.append("main: deletion is not a fast-forward update")
            continue
        if not zero(remote) and not ancestor(remote, local):
            errors.append(local + ": non-fast-forward update of main")
            continue
        baseline = config("workflow.pushBaseline")
        if not baseline:
            raise RuntimeError("workflow.pushBaseline is missing; conductor must run scripts/dev/install-hooks.sh")
        baseline = git("rev-parse", "--verify", baseline + "^{commit}").decode().strip()
        direct = set(config("workflow.directPaths", "docs/STATUS.md docs/TODO.md").split())
        revision = local if zero(remote) else remote + ".." + local
        commits = git("rev-list", "--first-parent", revision).decode().splitlines()
        for commit in commits:
            if ancestor(commit, baseline):
                continue
            parents = git("rev-list", "--parents", "-n", "1", commit).decode().split()[1:]
            if len(parents) > 1:
                message = git("show", "-s", "--format=%B", commit)
                trailers = subprocess.check_output(["git", "interpret-trailers", "--parse"], input=message)
                keys = {k.decode() for row in trailers.splitlines() for k, sep, value in [row.partition(b":")] if sep and value.strip()}
                missing = [k for k in ("Writer", "Reviewer", "Risk") if k not in keys]
                if missing:
                    errors.append(commit + ": merge missing trailers: " + ", ".join(missing))
            else:
                paths = git("diff-tree", "--root", "--no-commit-id", "--name-only", "-z", "-r", "--no-renames", commit)
                bad = [p.decode(errors="replace") for p in paths.split(b"\0") if p and p.decode(errors="replace") not in direct]
                if bad:
                    errors.append(commit + ": direct commit touches non-allowlisted paths: " + ", ".join(repr(p) for p in bad))
except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as e:
    errors.append("cannot verify main push: " + str(e))
if errors:
    print("pre-push: main rejected:\n  " + "\n  ".join(errors), file=sys.stderr)
    print("Client hooks can be skipped with --no-verify; this is not server-side enforcement.", file=sys.stderr)
    sys.exit(1)
'

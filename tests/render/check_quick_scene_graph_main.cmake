# Every test main() whose binary uses lab::OffscreenQuick calls lab::selectQuickSceneGraph()
# before RUN_ALL_TESTS: Qt fixes the scene graph backend at the first QQuickWindow of the
# process, so a later QQuickWindow made outside OffscreenQuick would select the software
# adaptation and break every GPU case after it (libs/gui/lab/RhiBackend.hpp).
# Usage: cmake -DSOURCE_DIR=<repo> -P check_quick_scene_graph_main.cmake
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
file(GLOB_RECURSE _headers "${SOURCE_DIR}/tests/*.hpp" "${SOURCE_DIR}/tests/*.h")
set(_scene_headers "")
foreach(_header IN LISTS _headers)
    file(READ "${_header}" _text)
    if(_text MATCHES "OffscreenQuick")
        get_filename_component(_name "${_header}" NAME)
        list(APPEND _scene_headers "${_name}")
    endif()
endforeach()
file(GLOB_RECURSE _sources "${SOURCE_DIR}/tests/*.cpp")
set(_checked 0)
set(_missing "")
foreach(_source IN LISTS _sources)
    file(READ "${_source}" _text)
    set(_uses OFF)
    if(_text MATCHES "OffscreenQuick")
        set(_uses ON)
    endif()
    foreach(_name IN LISTS _scene_headers)
        string(FIND "${_text}" "${_name}\"" _at)
        if(NOT _at EQUAL -1)
            set(_uses ON)
        endif()
    endforeach()
    string(FIND "${_text}" "int main(" _main)
    if(NOT _uses OR _main EQUAL -1)
        continue()
    endif()
    math(EXPR _checked "${_checked} + 1")
    string(SUBSTRING "${_text}" ${_main} -1 _body)
    string(FIND "${_body}" "RUN_ALL_TESTS" _run)
    string(FIND "${_body}" "selectQuickSceneGraph(" _select)
    if(_select EQUAL -1 OR (NOT _run EQUAL -1 AND _select GREATER _run))
        file(RELATIVE_PATH _relative "${SOURCE_DIR}" "${_source}")
        list(APPEND _missing "${_relative}")
    endif()
endforeach()
if(_checked EQUAL 0)
    message(FATAL_ERROR "no test main() using OffscreenQuick found under ${SOURCE_DIR}/tests")
endif()
if(_missing)
    list(JOIN _missing "\n  " _list)
    message(FATAL_ERROR "main() must call lab::selectQuickSceneGraph() before RUN_ALL_TESTS:\n  ${_list}")
endif()
message(STATUS "selectQuickSceneGraph in main: ${_checked} test sources checked")

{
    "version": 3,
    "configurePresets": [
      {
        "name": "windows-msvc-vs",
        "displayName": "Windows (MSVC + Visual Studio Generator)",
        "generator": "Visual Studio 17 2022",
        "architecture": "x64",
        "binaryDir": "${sourceDir}/build/windows-msvc-vs",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_PREFIX_PATH": "$env{QT_MSVC}"
        }
      },

      {
        "name": "windows-msvc-ninja",
        "displayName": "Windows (MSVC + Ninja, for clangd/IDE)",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/windows-msvc-ninja",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_PREFIX_PATH": "$env{QT_MSVC}",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
      },
  
      {
        "name": "mac-clang",
        "displayName": "macOS - Clang",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/mac-clang",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo",
          "CMAKE_C_COMPILER": "clang",
          "CMAKE_CXX_COMPILER": "clang++",
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_PREFIX_PATH": "$env{QT_MAC}",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
      },
      {
        "name": "mac-clang-release",
        "displayName": "macOS - Clang Release",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/mac-clang-release",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "clang",
          "CMAKE_CXX_COMPILER": "clang++",
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_PREFIX_PATH": "$env{QT_MAC}",
          "CMAKE_BUILD_TYPE": "Release",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
      },
  
      {
        "name": "linux-gcc",
        "displayName": "Linux - GCC",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/linux-gcc",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "gcc",
          "CMAKE_CXX_COMPILER": "g++",
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_PREFIX_PATH": "$env{QT_LINUX}",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
          "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja"
        }
      },
      {
        "name": "linux-cloud",
        "displayName": "Linux - Claude Code on the web (deps from scripts/setup/bootstrap-cloud.sh)",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/linux-cloud",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo",
          "CMAKE_PREFIX_PATH": "/opt/sentinel-deps/qt;/opt/sentinel-deps/prefix",
          "JWT_CPP_INCLUDE_DIR": "/opt/sentinel-deps/jwt-cpp/include",
          "CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES": "/opt/sentinel-deps/prefix/include",
          "FETCHCONTENT_SOURCE_DIR_GOOGLETEST": "/opt/sentinel-deps/googletest",
          "FETCHCONTENT_FULLY_DISCONNECTED": "ON",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
      }
    ],
  
    "buildPresets": [
      {
        "name": "windows-msvc-vs",
        "configurePreset": "windows-msvc-vs",
        "verbose": false,
        "nativeToolOptions": [
          "/v:minimal",
          "/nologo"
        ]
      },
      { "name": "windows-msvc-ninja",  "configurePreset": "windows-msvc-ninja" },
      { "name": "mac-clang",    "configurePreset": "mac-clang" },
      { "name": "mac-clang-release", "configurePreset": "mac-clang-release" },
      { "name": "linux-gcc",    "configurePreset": "linux-gcc" },
      { "name": "linux-cloud",  "configurePreset": "linux-cloud" }
    ],

    "testPresets": [
      {
        "name": "linux-cloud",
        "configurePreset": "linux-cloud",
        "output": {
          "outputOnFailure": true
        }
      },
      {
        "name": "windows-msvc-vs",
        "configurePreset": "windows-msvc-vs",
        "configuration": "Debug",
        "output": {
          "outputOnFailure": true
        }
      },
      {
        "name": "windows-msvc-ninja",
        "configurePreset": "windows-msvc-ninja",
        "output": {
          "outputOnFailure": true
        }
      }
    ]
  }
  
